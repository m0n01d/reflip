{
  "name": "reflip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rescript build && vite build",
    "clean": "rescript clean",
    "dev": "rescript build -w",
    "dev:web": "vite",
    "test": "npm run build && node src/tests/AllTests.res.mjs",
    "start": "node --env-file-if-exists=$HOME/.config/reflip/env src/Main.res.mjs",
    "email:check": "node --env-file-if-exists=$HOME/.config/reflip/env src/EmailCheck.res.mjs"
  },
  "dependencies": {
    "@rescript/react": "^0.15.0",
    "idb-keyval": "^6.3.0",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rescript": "^12.3.0",
    "vite": "^8.3.0"
  }
}
